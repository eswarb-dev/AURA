# Copy this to ~/.jarvis/.env (or alongside main.py) and chmod 600.
#
# A.U.R.A auto-detects backend on startup (in priority order):
#   - if CLAUDE_CODE_OAUTH_TOKEN is set → Claude Pro via Agent SDK (primary)
#   - else if OPENROUTER_API_KEY is set → OpenRouter
#   - else if JARVIS_OLLAMA_MODEL / JARVIS_OLLAMA_URL is set → Ollama (fully offline)
#   - on Claude failure, falls back to OpenRouter if available

# ─── Primary: Claude Pro subscription ──────────────────────────────────
# Get this token by running:
#   npm install -g @anthropic-ai/claude-code
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional model override (defaults to claude-sonnet-4-6)
# Available: claude-haiku-4-5, claude-sonnet-4-6, claude-opus-4-7
# JARVIS_CLAUDE_MODEL=claude-sonnet-4-6

# ─── Fallback: OpenRouter ──────────────────────────────────────────────
# Free models available, e.g. openai/gpt-oss-120b:free
# OPENROUTER_API_KEY=sk-or-...
# JARVIS_MODEL=openai/gpt-oss-120b:free

# ─── A.U.R.A diagnostics brain chain ──────────────────────────────────
# Used by /diagnostics voice bench: Groq primary, OpenRouter fallback.
AURA_REASONING_PRIMARY=groq
AURA_REASONING_FALLBACK=openrouter
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# AURA_OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-120b,openrouter/free
# GROQ_API_KEY=gsk_...
# AURA_FALLBACK_PROVIDER=openrouter
# AURA_GROQ_MODEL=openai/gpt-oss-20b
AURA_CLOUD_FAST_MODE=true
AURA_CLOUD_TIMEOUT_SECONDS=6
AURA_CLOUD_MAX_TOKENS=160
AURA_CLOUD_TEMPERATURE=0.4
AURA_CLOUD_MAX_RECENT_TURNS=4
AURA_CLOUD_MAX_CONTEXT_CHARS=2200
AURA_GENERAL_TALK_MAX_SENTENCES=4
AURA_GENERAL_TALK_MAX_CHARS=650
AURA_CARTESIA_CHUNK_MAX_CHARS=220
AURA_CARTESIA_PREFETCH_CHUNKS=2
AURA_CARTESIA_CHUNK_TIMEOUT_SECONDS=8

# ─── A.U.R.A Expo Vision Identity Mode ────────────────────────────────
# Browser camera/mic are opt-in from /diagnostics. Raw media is not stored.
AURA_EXPO_DEMO_MODE=true
AURA_ENABLE_EXPO_VISION_IDENTITY=true
AURA_FACE_MATCH_THRESHOLD=0.75
AURA_VOICE_MATCH_THRESHOLD=0.70
AURA_GENDER_CONFIDENCE_THRESHOLD=0.75
AURA_IDENTITY_LIVE_MATCH_TTL_MS=5000
AURA_TRACKING_START_VERIFY_TIMEOUT_MS=5000
AURA_PEOPLE_TRACKING_VIDEO_READY_TIMEOUT_MS=7000
AURA_PEOPLE_TRACKING_MODEL_READY_TIMEOUT_MS=10000
AURA_PEOPLE_TRACKING_BOOT_START_DELAY_MS=500
VITE_AURA_IDENTITY_LIVE_MATCH_TTL_MS=5000
VITE_AURA_TRACKING_START_VERIFY_TIMEOUT_MS=5000
VITE_AURA_PEOPLE_TRACKING_VIDEO_READY_TIMEOUT_MS=7000
VITE_AURA_PEOPLE_TRACKING_MODEL_READY_TIMEOUT_MS=10000
VITE_AURA_PEOPLE_TRACKING_BOOT_START_DELAY_MS=500
AURA_IDENTITY_STORAGE_DIR=diagnostics/identity

# ─── Offline: Ollama ───────────────────────────────────────────────────
# Run a fully-local model with no internet/subscription. Install Ollama
# (https://ollama.com), then `ollama pull llama3.1` (or any tool-capable model
# such as qwen2.5, mistral). Set the model to activate this backend:
# JARVIS_OLLAMA_MODEL=llama3.1
# JARVIS_OLLAMA_URL=http://localhost:11434

# ─── Force a specific backend (auto | claude | openrouter | ollama) ────
# JARVIS_LLM_BACKEND=auto

# ─── IMPORTANT: leave this UNSET to use OAuth/Pro ──────────────────────
# If ANTHROPIC_API_KEY is set, it shadows the OAuth token and bills
# against your API account (not your Pro plan).
# unset ANTHROPIC_API_KEY

# ─── Optional voice / search backends ──────────────────────────────────
# JARVIS_WHISPER_MODEL=base.en
# JARVIS_PIPER_BIN=piper
# SEARX_URL=http://localhost:8080
# BRAVE_API_KEY=

# ─── Wake-word capture / VAD (needs webrtcvad: pip install webrtcvad) ───
# With webrtcvad installed, A.U.R.A stops listening when you finish speaking.
# JARVIS_CAPTURE_SECONDS=8         # hard cap on capture length
# JARVIS_VAD_SILENCE_MS=800        # trailing silence that ends capture
# JARVIS_VAD_AGGRESSIVENESS=2      # 0 (lenient) .. 3 (aggressive)
# JARVIS_VAD_START_TIMEOUT=3.0     # give up if no speech starts within N sec
AURA_ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID=
JARVIS_ELEVENLABS_VOICE_ID=
ELEVENLABS_API_KEY=

# ─── Cartesia Sonic cloud TTS ──────────────────────────────────────────
CARTESIA_API_KEY=
AURA_CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
AURA_CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.5
CARTESIA_VERSION=2024-11-13
CARTESIA_OUTPUT_CONTAINER=wav
CARTESIA_SAMPLE_RATE=44100
CARTESIA_ENCODING=pcm_s16le
AURA_CARTESIA_TTS_TIMEOUT_SECONDS=5
AURA_CARTESIA_TTS_CHUNK_TIMEOUT_SECONDS=8

# ─── Fish Audio cloud TTS fallback ─────────────────────────────────────
# FISH_AUDIO_REFERENCE_ID is a Fish Audio reference ID, not an ElevenLabs voice ID.
FISH_AUDIO_API_KEY=
AURA_FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
AURA_FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_MODEL=s2-pro
# Ignored when AURA_TTS_REQUIRED_PROVIDER=cartesia.
AURA_TTS_PROVIDER_PRIORITY=cartesia,fish_audio,elevenlabs,browser_speech
AURA_TTS_STRICT_PRIMARY=true
AURA_TTS_REQUIRED_PROVIDER=cartesia
AURA_TTS_ALLOW_BROWSER_FALLBACK=false
# Expo-only laptop Main Orb fallback; keep disabled unless Cartesia is unavailable.
AURA_EXPO_ALLOW_BROWSER_TTS_FALLBACK=false
# Keep deterministic route speech inline by default; enable only after async TTS is verified.
AURA_DETERMINISTIC_TTS_DEFERRED=false

# Weather
AURA_WEATHER_PROVIDER=auto
AURA_DEFAULT_CITY=Coimbatore
AURA_DEFAULT_COUNTRY=India
AURA_DEFAULT_LATITUDE=
AURA_DEFAULT_LONGITUDE=
AURA_WEATHERAPI_KEY=
AURA_OPENWEATHER_API_KEY=
AURA_WEATHER_STRICT_LOCATION=true
AURA_WEATHER_ALLOW_DEFAULT_ONLY_WHEN_LOCATION_MISSING=true
AURA_WEATHER_TIMEOUT_SECONDS=8
AURA_WEATHER_CACHE_TTL_SECONDS=600

# News
TAVILY_API_KEY=
NEWSAPI_KEY=
AURA_NEWS_PROVIDER=tavily
AURA_NEWS_TIMEOUT_SECONDS=4
AURA_NEWS_MAX_HEADLINES=5
AURA_NEWS_REGION=IN

# Files
AURA_ALLOWED_FILE_ROOTS=E:\AURA AGENT;C:\Users\choos\Downloads;C:\Users\choos\Documents

# Tool safety
AURA_ENABLE_LOCAL_TOOLS=true
AURA_ENABLE_CONFIRM_REQUIRED_ACTIONS=false
AURA_TOOL_AUDIT_LOG=true

# Browser automation
AURA_ENABLE_BROWSER_TOOL=true
AURA_DEFAULT_BROWSER=chrome
AURA_DEFAULT_SEARCH_ENGINE=google
AURA_BROWSER_SAFE_MODE=true
AURA_BROWSER_ALLOW_OPEN_URL=true
AURA_BROWSER_ALLOW_SEARCH=true
AURA_BROWSER_ALLOW_FORM_SUBMIT=false
AURA_BROWSER_ALLOW_CLICK_ACTIONS=false

# Chrome MCP browser execution (AURA-controlled separate windows)
AURA_BROWSER_MCP_ENABLED=false
AURA_BROWSER_MCP_MODE=auto
AURA_BROWSER_MCP_BROWSER_URL=http://127.0.0.1:9222
AURA_BROWSER_WINDOW_MODE=separate
AURA_BROWSER_WINDOW_WIDTH=1280
AURA_BROWSER_WINDOW_HEIGHT=850

# Mobile remote control is off by default. The token is required for phones.
AURA_REMOTE_CONTROL_ENABLED=false
AURA_REMOTE_CONTROL_TOKEN=

# Persistent memory is backend-only. Never expose the service-role key to frontend code.
AURA_MEMORY_BACKEND=supabase
AURA_SUPABASE_URL=
AURA_SUPABASE_SERVICE_ROLE_KEY=
AURA_MEMORY_OWNER_KEY=eswar_local
AURA_MEMORY_WRITE_ENABLED=true
AURA_MEMORY_READ_ENABLED=true
AURA_MEMORY_LOCAL_FALLBACK=true
AURA_MEMORY_MAX_CONTEXT_CHARS=4000
AURA_MEMORY_STORE_RAW_TURNS=true
AURA_MEMORY_REDACT_SECRETS=true
